<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/portfolio_surface" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yeni varlık" android:textColor="@color/portfolio_text" android:textSize="21sp" android:textStyle="bold" android:layout_marginBottom="18dp"/>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Varlık adı"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:textColor="@color/portfolio_text"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Sembol (THYAO, BTC, XAU...)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etTicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:textColor="@color/portfolio_text"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Miktar"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/portfolio_text"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Birim alış maliyeti (TL)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etCostPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:textColor="@color/portfolio_text"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:text="Portföye ekle" android:textColor="@color/portfolio_navy" app:backgroundTint="@color/portfolio_green"/>
</LinearLayout>