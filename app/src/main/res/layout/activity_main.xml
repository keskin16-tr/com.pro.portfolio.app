<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/portfolio_navy">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORTFOLIO PRO"
                        android:textColor="@color/portfolio_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.16" />
                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/dashboard_title"
                        android:textColor="@color/portfolio_text"
                        android:textSize="27sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="₺"
                    android:textColor="@color/portfolio_green"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tarih ve saat yükleniyor..."
                android:textColor="@color/portfolio_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTopAddAsset"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Varlık ekle"
                    android:textColor="@color/portfolio_navy"
                    android:textStyle="bold"
                    app:backgroundTint="@color/portfolio_green"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconTint="@color/portfolio_navy" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTopSell"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Satış yap"
                    android:textColor="@color/portfolio_navy"
                    android:textStyle="bold"
                    app:backgroundTint="@color/portfolio_orange"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="@color/portfolio_navy" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTopImportExcel"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Excel içe aktar"
                    android:textColor="@color/portfolio_navy"
                    android:textStyle="bold"
                    app:backgroundTint="@color/portfolio_blue"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconTint="@color/portfolio_navy" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTopAddDividend"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Temettü ekle"
                    android:textColor="@color/portfolio_navy"
                    android:textStyle="bold"
                    app:backgroundTint="@color/portfolio_purple"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_menu_my_calendar"
                    app:iconTint="@color/portfolio_navy" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/portfolio_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#263B53"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/invested_total"
                        android:textColor="@color/portfolio_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="₺0,00"
                        android:textColor="@color/portfolio_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_green" />
                        <TextView
                            android:id="@+id/tvAssetCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="0 varlık"
                            android:textColor="@color/portfolio_green"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Alış maliyeti bazında"
                            android:textColor="@color/portfolio_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Toplam net temettü"
                        android:textColor="@color/portfolio_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDividendTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₺0,00"
                        android:textColor="@color/portfolio_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddDividend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Temettü kaydı ekle"
                        android:textColor="@color/portfolio_navy"
                        app:backgroundTint="@color/portfolio_green" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Portföy dağılımı"
                    android:textColor="@color/portfolio_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maliyet"
                    android:textColor="@color/portfolio_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/portfolio_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">
                    <com.portfolio.app.ui.chart.PortfolioDonutView
                        android:id="@+id/portfolioChart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <TextView
                        android:id="@+id/tvChartEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Dağılım grafiği için\nvarlık ekleyin"
                        android:textColor="@color/portfolio_muted"
                        android:textSize="13sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSellAsset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Varlık satışı yap"
                android:textColor="@color/portfolio_text"
                app:backgroundTint="@color/portfolio_surface"
                app:strokeColor="@color/portfolio_green"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="8dp"
                android:text="İşlem geçmişi"
                android:textColor="@color/portfolio_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTradeHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_empty"
                android:padding="16dp"
                android:text="Henüz işlem bulunmuyor."
                android:textColor="@color/portfolio_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/holdings_title"
                    android:textColor="@color/portfolio_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvHoldingsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kayıt"
                    android:textColor="@color/portfolio_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_empty"
                android:gravity="center"
                android:padding="28dp"
                android:text="@string/empty_portfolio_hint"
                android:textColor="@color/portfolio_muted"
                android:textSize="13sp"
                android:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewAssets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddAsset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="22dp"
        android:contentDescription="@string/add_asset"
        android:text="@string/add_asset"
        android:textColor="@color/portfolio_navy"
        app:backgroundTint="@color/portfolio_green"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/portfolio_navy" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
