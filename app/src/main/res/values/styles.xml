<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Uygulama her zaman koyu temada çalışır. Eskiden DayNight temasında
         telefon açık moddayken diyalog kutuları beyaz oluyor, kodda ise yazı
         rengi beyaza zorlandığı için girilen değerler görünmüyordu. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#4778F5</item>
        <item name="colorPrimaryVariant">#315BD1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#36D6B4</item>
        <item name="colorOnSecondary">#06231C</item>
        <item name="colorSurface">#182337</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:colorBackground">#0B1220</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorError">#FF6978</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9AAAC3</item>
        <item name="android:textColorHint">#75849C</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:navigationBarColor">#0B1220</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
    </style>

    <style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">#182337</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorPrimary">#7FA2FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9AAAC3</item>
    </style>

</resources>